# Hugging Face Inference Providers token (used for video generation).
# Get one at https://huggingface.co/settings/tokens — needs "Inference" permission.
HF_TOKEN=

# Random secret used to sign session cookies. Generate your own, don't reuse
# this repo's dev value: `openssl rand -hex 32`
AUTH_SECRET=

# Postgres connection string — the POOLED variant (Neon: "Pooled connection"
# in the dashboard; Supabase: "Transaction" pooler mode). Used for all normal
# app queries at runtime.
DATABASE_URL=

# Postgres connection string — the DIRECT/UNPOOLED variant (same host as
# DATABASE_URL, minus "-pooler" on Neon). Used only by `prisma migrate
# deploy`/CLI commands, which need a session-level lock that pooled
# connections don't reliably support. See DEPLOY.md for why this bit us once.
DIRECT_URL=

# S3-compatible object storage (Backblaze B2 here) for uploaded reference
# images and generated video output. Bucket is PRIVATE — the app generates
# short-lived presigned URLs per object, not a public bucket URL.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
