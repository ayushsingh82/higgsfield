generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer, transaction mode) doesn't reliably
  // support the session-level advisory lock `prisma migrate deploy` takes
  // before applying migrations (P1002 timeout) — documented Prisma+Neon
  // interaction, not flakiness. `directUrl` is used by migrate/CLI commands
  // specifically; normal app queries still go through the pooled `url`.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  credits      Int          @default(100)
  createdAt    DateTime     @default(now())
  generations  Generation[]
}

enum GenerationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Generation {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  prompt            String
  referenceImageKey String?
  provider          String
  model             String
  aspectRatio       String
  durationSec       Int
  status            GenerationStatus  @default(PENDING)
  outputKey         String?
  creditsCost       Int
  errorMessage      String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  @@index([userId, createdAt])
}
